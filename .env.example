# ============================================================================
# Copie acest fișier ca ".env" pentru dezvoltare locală, sau adaugă fiecare
# variabilă direct în Vercel: Project → Settings → Environment Variables.
# Vezi SETUP.md pentru un ghid pas-cu-pas complet, cu link-uri unde obții
# fiecare cheie.
# ============================================================================

# --- OBLIGATORII — aplicația nu pornește / nu te poți loga fără ele ---------

# Connection string Postgres (Neon). Din Vercel: Storage → Create Database →
# Neon → conectează la acest proiect (injectează automat DATABASE_URL).
DATABASE_URL=

# Secret aleator pentru sesiuni NextAuth. Generează cu: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL-ul public al deployment-ului (fără slash la final), ex: https://numele-tau.vercel.app
NEXTAUTH_URL=

# Email-urile permise să se logheze, separate prin virgulă (fără spații extra
# nu contează, se face trim). SINGURUL mecanism de autentificare e cod OTP pe
# email — dacă emailul tău nu e aici, nu te poți loga deloc.
ADMIN_EMAILS=tu@exemplu.com,prieten@exemplu.com

# Cheie API Resend (resend.com) — trimite email-urile cu codul OTP de login
# și rapoartele săptămânale/lunare. Fără ea, nimeni nu se poate loga.
RESEND_API_KEY=

# Secret arbitrar, folosit ca să verificăm că request-urile către /api/cron/*
# chiar vin de la Vercel Cron (Vercel adaugă automat acest header când
# CRON_SECRET e setat). Generează cu: openssl rand -hex 32
CRON_SECRET=

# --- Boții DCA — Solana (opțional, doar dacă vrei botul de Solana) --------

# Cheia privată (base58) a unui portofel Solana DEDICAT exclusiv botului —
# NICIODATĂ un portofel personal existent. Fondează-l doar cu cât vrei să
# ruleze botul (ex: 50-200$ echivalent).
SOLANA_PRIVATE_KEY=

# RPC Solana — endpoint-ul public e nesigur pentru trafic de producție.
# Alchemy sau Helius au tier gratuit generos, suficient pentru un bot care
# rulează 1x/zi.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Opțional — cheie API Jupiter (jup.ag), crește limitele de rate. Nu e
# necesară la volumul unui bot care rulează de câteva ori pe zi.
JUPITER_API_KEY=

# Adresa portofelului "cold" unde se retrage lunar SOL-ul acumulat peste
# minim. Poate fi orice adresă Solana a ta.
SOLANA_SWEEP_DESTINATION=

# --- Botul DCA — Base / ETH L2 (opțional, doar dacă vrei botul de Base) ---

# Cheia privată (hex, cu 0x) a unui portofel EVM DEDICAT exclusiv botului —
# la fel ca la Solana, niciodată un portofel personal existent.
BASE_PRIVATE_KEY=

# RPC Base — Alchemy sau Infura, tier gratuit e suficient.
BASE_RPC_URL=https://mainnet.base.org

# Cheie API 1inch (portal.1inch.dev) — obligatorie pentru swap-uri și ordine
# limită pe Base. Cont gratuit, generezi cheia din dashboard-ul lor.
ONEINCH_API_KEY=

# Adresa unde se retrage lunar tot WETH-ul acumulat.
BASE_SWEEP_DESTINATION=

# --- Prețuri crypto pentru graficele BTC (opțional) -------------------------

# Fără cheie funcționează pe tier-ul gratuit CoinGecko, cu limite de rate mai
# mici. O cheie demo gratuită de la coingecko.com ridică limitele.
COINGECKO_API_KEY=

# Opțional — folosit ca sursă alternativă/backup pentru preț BTC.
# coinmarketcap.com/api are un tier gratuit.
CMC_API_KEY=

# --- OCR chitanțe (opțional — doar dacă vrei scanare automată de bonuri) ---

# Cont de serviciu Google Cloud Vision (JSON key) — client_email și
# private_key din fișierul JSON descărcat din Google Cloud Console.
GOOGLE_VISION_CLIENT_EMAIL=
GOOGLE_VISION_PRIVATE_KEY=

# --- Stocare fișiere (opțional — chitanțe/documente scanate) ---------------

# Cloudflare R2 (compatibil S3, tier gratuit generos). Din dashboard-ul
# Cloudflare: R2 → Create bucket → Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Email-uri trimise de aplicație (opțional, dincolo de OTP) -------------

# Adresa "from" pentru codurile OTP — dacă nu ai un domeniu verificat în
# Resend, lasă gol (folosește automat onboarding@resend.dev).
EMAIL_FROM=

# Adresa "from" / destinatarul rapoartelor săptămânale/lunare automate.
# Dacă REPORT_EMAIL_TO lipsește, rapoartele automate sunt pur și simplu
# dezactivate (fără eroare).
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# --- Trading212 (opțional — doar dacă vrei sincronizarea automată T212) ---

# Din T212: Settings → API → generează o cheie (Practice sau Live).
T212_API_KEY=
T212_API_SECRET=
T212_ENVIRONMENT=live
