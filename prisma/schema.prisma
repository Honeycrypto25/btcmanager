  // lives only as the BNB_SWEEP_DESTINATION Vercel env var, so
  // redirecting where funds go requires Vercel dashboard access, not just
  // a compromised web session (same reasoning as keeping the private key
  // out of the database).
  sweepEnabled        Boolean @default(false)
  sweepMinBalanceBnb Decimal @default(0) @db.Decimal(20, 9) // always left behind in the hot wallet, ON TOP OF whatever's reserved for open sell orders (see sweep.ts — unlike Solana, a 1inch order doesn't escrow funds on-chain)

  lastSweepAt     DateTime?
  lastSweepStatus String? // "ok" | "skipped" | "error"
  lastSweepError  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per executed (or attempted) monthly sweep — the excess WBNB above
