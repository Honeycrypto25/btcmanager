// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  
  // 2FA Fields
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  pendingTotpSecret   String?   // Secret temporar la setup 2FA — șters după activare

  // OTP Login Fields
  loginOtp            String?
  loginOtpExpires     DateTime?
  otpAttempts         Int?      // Rate limiting: număr cereri în fereastra curentă
  otpWindowStart      DateTime? // Rate limiting: începutul ferestrei de 10 minute
  
  accounts      Account[]
  sessions      Session[]

  // --- Personal finance & life dashboard (Phase 1+) ---
  selfEmployedIncomes  SelfEmployedIncome[]
  selfEmployedExpenses SelfEmployedExpense[]
  receipts             Receipt[]
  merchantRules        MerchantRule[]
  bankAccounts         BankAccount[]
  bankImportBatches    BankImportBatch[]
  bankTransactions     BankTransaction[]
  vehicles             Vehicle[]
  fuelEntries          FuelEntry[]
  maintenanceRecords   MaintenanceRecord[]
  documents            Document[]
  reminders            Reminder[]
  vanguardAccounts     VanguardAccount[]
  vanguardHoldings     VanguardHolding[]
  financialGoals       FinancialGoal[]
  solanaSettings       SolanaSettings?
  solanaLots           SolanaLot[]
  solanaSweeps         SolanaSweep[]
  evmSettings          EvmSettings?
  evmLots              EvmLot[]
  evmSweeps            EvmSweep[]
  bnbSettings          BnbSettings?
  bnbLots              BnbLot[]
  bnbSweeps            BnbSweep[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BitcoinWallet {
  id           String    @id @default(cuid())
  name         String
  address      String    @unique
  transactions BitcoinTransaction[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BitcoinTransaction {
  id           String    @id @default(cuid())
  txid         String    
  amount       Float     // BTC amount
  priceAtTime  Float     // Historical price at time of tx
  timestamp    DateTime
  
  walletId     String
  wallet       BitcoinWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime  @default(now())

  @@unique([txid, walletId])
}

// --- Trading 212 integration ---

model T212Account {
  id            String    @id @default(cuid())
  environment   String    @default("live") // "live" | "demo" — from T212_ENVIRONMENT env var
  currency      String? // primary account currency, from account/info
  lastSyncedAt  DateTime?
  lastSyncError String?   @db.Text
  lastTxSyncInfo String?  @db.Text // diagnostic, populat la fiecare sync indiferent de rezultat: câte tranzacții s-au primit de la T212 și ce tipuri

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots T212Snapshot[]
  cashFlows T212CashFlow[]
  orders    T212Order[]

  @@unique([environment])
}

model T212Snapshot {
  id            String   @id @default(cuid())
  accountId     String
  capturedAt    DateTime @default(now())
  totalValue    Float // total account value (cash + invested)
  investedValue Float // cost basis of currently open positions
  freeCash      Float
  resultPpl     Float // unrealized P&L
  currency      String
  positions     Json // snapshot of open positions at capture time
  pies          Json // snapshot of pies (reflects current, post-rebalance allocations)

  account T212Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
}

model T212CashFlow {
  id         String   @id @default(cuid())
  accountId  String
  externalId String // Trading 212 transaction id, for de-duplication
  type       String // DEPOSIT | WITHDRAWAL | ...
  amount     Float
  dateTime   DateTime

  account T212Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId, dateTime])
}

// Comenzi executate (cumpărări/vânzări) — sursa principală pentru "cât s-a
// investit" la conturile cu investiție automată recurentă, unde banii nu
// trec printr-o "depunere" separată vizibilă, ci direct în ordine de cumpărare.
model T212Order {
  id             String   @id @default(cuid())
  accountId      String
  externalId     String // id-ul ordinului la T212, pentru deduplicare
  ticker         String
  name           String
  side           String // BUY | SELL
  quantity       Float
  price          Float
  priceCurrency  String
  total          Float // sumă totală, în moneda contului
  filledAt       DateTime
  realizedProfit Float?

  account T212Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId, filledAt])
}

// --- Self Employed: Income ---
// Part of the broader "Personal Finance & Life Dashboard" expansion.
// Additive only — does not touch BitcoinWallet/T212* models above.

model SelfEmployedIncome {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date          DateTime
  description   String
  client        String?
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String?
  taxYear       String   // UK tax year, e.g. "2026-27"
  notes         String?  @db.Text

  // Set when this income row was created via convertTransactionToIncome
  // (see actions/bank.ts) -- not a hard FK, mirrors
  // SelfEmployedExpense.bankTransactionId. Lets the UI show which bank
  // account an income entry actually came from.
  bankTransactionId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, taxYear])
  @@index([userId, date])
}

// --- Self Employed: Expenses ---

model SelfEmployedExpense {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date                   DateTime
  merchant               String
  description            String?
  amount                 Decimal  @db.Decimal(12, 2)
  vatAmount              Decimal? @db.Decimal(12, 2)
  category               String
  paymentMethod          String?

  // Reserved for later phases (receipts / bank matching) — no FK yet on
  // purpose, since those tables don't exist until Phase 2/3.
  receiptId              String?
  bankTransactionId      String?

  businessUsePercentage  Int      @default(100)
  allowableExpenseStatus String   @default("allowable")
  taxYear                String

  notes                  String?  @db.Text

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId, taxYear])
  @@index([userId, category])
  @@index([userId, date])
}

// --- Internal build roadmap / task tracker ---
// Powers the in-app "Tasks" menu: shows what's planned per phase, lets us
// check items off as they're built, and doubles as a development history log.

model DevTask {
  id          String        @id @default(cuid())
  phase       String        // e.g. "Phase 1"
  section     String        // e.g. "Self Employed", "Income", "Navigation"
  title       String
  description String?       @db.Text
  status      DevTaskStatus @default(PLANNED)
  order       Int           @default(0)
  completedAt DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([phase])
  @@index([status])
}

enum DevTaskStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

// --- Receipts (Phase 2) ---
// The image itself always lives in Cloudflare R2 — only metadata + object
// keys are stored here. OCR fields are populated later (Phase 2 continued);
// for now they stay null and the UI collects details manually.

model Receipt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  merchant      String?
  receiptDate   DateTime?
  receiptTime   String?
  amount        Decimal? @db.Decimal(12, 2)
  vatAmount     Decimal? @db.Decimal(12, 2)
  currency      String   @default("GBP")
  category      String?
  description   String?  @db.Text
  paymentMethod String?
  taxYear       String?

  // Links this receipt to a vehicle — mainly for fuel receipts paid in cash,
  // which never appear in a bank statement and so can't be tracked via
  // BankTransaction. When set, the receipt can optionally carry the odometer
  // reading + litres so it feeds into the same MPG/cost-per-mile calculation
  // as the vehicle's own fuel journal (lib/vehicles/stats.ts), not a
  // separate/parallel one.
  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Fuel-specific — only meaningful when vehicleId is set and this receipt
  // represents a fuel purchase. All optional: a receipt can be linked to a
  // vehicle for record-keeping without necessarily feeding the MPG math.
  vehicleMileage     Int?
  fuelQuantityLitres Decimal? @db.Decimal(8, 3)
  isFullTank         Boolean?

  // --- Cloudflare R2 storage (private objects, accessed via signed URLs) ---
  originalObjectKey String
  previewObjectKey  String?
  originalMimeType  String
  originalFileSize  Int
  previewFileSize   Int?

  // --- OCR / AI (architecture only for now — populated once OCR is enabled) ---
  ocrRawText    String?  @db.Text
  ocrConfidence Float?
  aiProcessed   Boolean  @default(false)

  // Reserved — bank_transactions table doesn't exist until Phase 3.
  matchedTransactionId String?
  matchConfidence       Float?

  status String @default("unmatched") // unmatched | matched | needs_review

  // Set once the user converts this receipt into a SelfEmployedExpense row
  // (see actions/receipts.ts convertReceiptToExpense) -- mainly for cash
  // purchases (like the vehicle-linked fuel receipts above) that have no
  // bank transaction to convert instead. Null means not converted yet.
  convertedExpenseId String?

  retentionUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, taxYear])
  @@index([userId, status])
  @@index([userId, receiptDate])
  @@index([userId, merchant])
}

// --- Merchant normalization rules ---
// Simple rule-based mapping (not ML): when the user corrects a merchant's
// category once, we remember it so future receipts from the same merchant
// prefill the same category automatically.

model MerchantRule {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchText          String   // substring matched against merchant, case-insensitive
  merchantNormalized String   // canonical display name, e.g. "Shell"
  category           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchText])
  @@index([userId])
}

// --- Bank transactions (Phase 3) ---
// V1 is manual CSV import — format-agnostic via a user-configured column
// mapping stored per batch, not hardcoded to one bank's export layout.

model BankAccount {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  currency  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importBatches BankImportBatch[]
  transactions  BankTransaction[]

  @@index([userId])
}

model BankImportBatch {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  filename       String
  columnMapping  Json   // records which CSV header was mapped to which field, for audit/debugging
  rowCount       Int
  importedCount  Int
  duplicateCount Int

  createdAt DateTime @default(now())

  transactions BankTransaction[]

  @@index([userId])
  @@index([userId, createdAt])
}

model BankTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String?
  account   BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  transactionDate    DateTime
  description        String
  merchantNormalized String?
  amount             Decimal  @db.Decimal(12, 2)
  debitCredit        String   // DEBIT | CREDIT
  balance            Decimal? @db.Decimal(12, 2)
  category           String?

  // Matching against receipts (see lib/bank/matching.ts). Not a hard FK on
  // purpose — a rejected/undone match shouldn't cascade-delete anything.
  receiptId      String?
  matchConfidence Float?
  matchStatus     String  @default("unmatched") // unmatched | possible_match | matched

  // Conversion into Income/Expenses — set once the user marks a transaction
  // as business income, a business expense, or explicitly personal/ignored.
  // Not a hard FK on purpose, mirroring the receipt-matching fields above.
  convertedType     String? // income | expense | ignored
  convertedRecordId String?

  taxYear       String
  importBatchId String
  importBatch   BankImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  // Stable hash of (date, description, amount) for this user — prevents
  // importing the same row twice across separate CSV uploads.
  originalRowHash String

  createdAt DateTime @default(now())

  @@unique([userId, originalRowHash])
  @@index([userId, taxYear])
  @@index([userId, transactionDate])
  @@index([userId, matchStatus])
  @@index([receiptId])
}

// --- Vehicles / Fuel / Maintenance / Documents / Reminders (Phase 5) ---
// Additive only — no changes to any model above. All rows are scoped by
// userId directly (not only reachable via vehicleId), matching the same
// ownership-check pattern used everywhere else in the app.

model Vehicle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String // user-facing label, e.g. "Skoda Octavia"
  make               String?
  model              String?
  year               Int?
  registrationNumber String?
  fuelType           String? // petrol | diesel | electric | hybrid | other
  currentMileage     Int?
  isActive           Boolean @default(true)
  notes              String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fuelEntries        FuelEntry[]
  maintenanceRecords MaintenanceRecord[]
  documents          Document[]
  reminders          Reminder[]
  receipts           Receipt[]

  @@index([userId])
}

model FuelEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date         DateTime
  mileage      Int? // odometer reading at this fill-up
  quantity     Decimal  @db.Decimal(8, 2) // litres (or gallons, see unit)
  unit         String   @default("litres")
  cost         Decimal  @db.Decimal(10, 2)
  pricePerUnit Decimal? @db.Decimal(8, 3)
  // MPG/cost-per-mile can only be computed between consecutive FULL
  // tank fill-ups — a partial fill-up breaks the distance/quantity math.
  isFullTank   Boolean  @default(true)
  station      String?
  notes        String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, vehicleId])
  @@index([vehicleId, date])
}

model MaintenanceRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type     String // e.g. "MOT", "Service", "Tyres", "Brakes"
  date     DateTime
  mileage  Int?
  cost     Decimal? @db.Decimal(10, 2)
  provider String?
  notes    String?  @db.Text

  // Used to compute the green/amber/red status shown in the UI.
  nextDueDate    DateTime?
  nextDueMileage Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, vehicleId])
  @@index([vehicleId, date])
}

// Generic document vault — not limited to vehicle documents (spec covers
// MOT/insurance certificates, but this is intentionally general-purpose).
// Same private-object-in-R2 + metadata-in-Neon pattern as Receipt.

model Document {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category String // e.g. "Insurance", "MOT", "Warranty", "ID", "Other"
  title    String
  notes    String? @db.Text

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // --- Cloudflare R2 storage (private object, accessed via signed URL) ---
  objectKey        String
  originalMimeType String
  fileSize         Int

  issueDate  DateTime?
  expiryDate DateTime?

  // Safe lifecycle: an optional user-set (or user-confirmed) date after
  // which a document is flagged as "past retention" in the UI. Purely
  // informational — deletion is, and stays, a manual action only. No
  // automated/scheduled deletion exists or is planned; this field just
  // makes stale documents visible so the user can decide.
  retentionUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders Reminder[]

  @@index([userId, category])
  @@index([userId, expiryDate])
  @@index([vehicleId])
}

model Reminder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  type    String? // e.g. "MOT", "Insurance", "Service", "Other"
  dueDate DateTime
  notes   String? @db.Text

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  isDismissed Boolean   @default(false)
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueDate])
  @@index([userId, isDismissed])
  @@index([vehicleId])
}

// --- Vanguard / Goals (Phase 6) ---
// Additive only. Vanguard has no public API for retail investors, so this
// is manual entry (or future statement import) — not a live sync like T212.
// Investments Overview (see /investments) reads BTC + T212 totals from the
// EXISTING lib/overview-data.ts (unmodified) and shows Vanguard alongside
// as separate figures, per spec: never combine incomparable metrics.

model VanguardAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String // e.g. "Stocks & Shares ISA"
  accountType String? // ISA | GIA | SIPP | JISA | Other
  currency    String  @default("GBP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdings VanguardHolding[]

  @@index([userId])
}

model VanguardHolding {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   VanguardAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fundName String
  ticker   String?
  units    Decimal? @db.Decimal(14, 4)

  // Manually entered/updated by default — auto-refreshed instead for
  // holdings with both ticker/ISIN and units set (see
  // lib/vanguard-price-sync.ts).
  costBasis      Decimal  @db.Decimal(12, 2) // total invested in this holding
  currentValue   Decimal  @db.Decimal(12, 2)
  valueUpdatedAt DateTime @default(now())

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory VanguardPriceHistory[]

  @@index([userId, accountId])
}

// One row per successful auto price lookup (see syncVanguardPrices) —
// deduped to ~one per calendar day per holding, so a user can see how a
// holding's unit price evolved since they set up ticker/ISIN + units,
// not just the latest value. Cascade-deletes with the holding since this
// history has no meaning independent of it (unlike the app's soft-join
// references elsewhere, which deliberately avoid cascading).
model VanguardPriceHistory {
  id        String          @id @default(cuid())
  holdingId String
  holding   VanguardHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  price      Decimal  @db.Decimal(14, 4)
  currency   String
  capturedAt DateTime @default(now())

  @@index([holdingId, capturedAt])
}

model FinancialGoal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  category      String? // Savings | Investment | Debt payoff | Emergency fund | Other
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  currency      String    @default("GBP")
  targetDate    DateTime?
  notes         String?   @db.Text
  isAchieved    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


// --- Solana DCA bot ---
// Self-custody, single dedicated wallet per user. The private key never
// touches this database — it lives only as an env var on Vercel
// (SOLANA_PRIVATE_KEY), read at cron-execution time by src/lib/solana.
// Everything here is bookkeeping/config only.
//
// Flow: a Vercel Cron hits /api/cron/solana-dca every hour. The handler
// checks each enabled SolanaSettings row — if `intervalHours` have passed
// since `lastRunAt`, it buys `buyAmountUsd` of SOL via Jupiter's Swap API,
// then immediately places a Jupiter Trigger (limit) order to sell
// `sellAmountUsd` worth of the SOL just bought once the price rises by
// `takeProfitPercent`. Jupiter's own keeper network executes that order
// later — this app does not poll price in between.

model SolanaSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  // Public key only — never the private key. Shown in the UI so the user
  // can verify/fund the right wallet; also used to query Jupiter/RPC.
  walletAddress String

  buyAmountUsd      Decimal @db.Decimal(10, 2) // e.g. 10.00 — spent each cycle
  intervalHours     Int     @default(24)
  takeProfitPercent Decimal @db.Decimal(6, 2) // e.g. 10.00 for "sell at +10%"
  sellAmountUsd     Decimal @db.Decimal(10, 2) // USD value of SOL sold per lot at target
  slippageBps       Int     @default(50) // 50 = 0.5%, applied to the buy swap only

  lastRunAt     DateTime?
  lastRunStatus String? // "ok" | "skipped" | "error"
  lastRunError  String? @db.Text

  // --- Monthly auto-sweep to a cold wallet ---
  // Off by default — must be explicitly turned on after verifying with the
  // manual "Trimite acum" test. The destination address is deliberately
  // NOT stored here: it lives only as the SOLANA_SWEEP_DESTINATION Vercel
  // env var, so redirecting where funds go requires Vercel dashboard
  // access, not just a compromised web session (same reasoning as keeping
  // the private key out of the database).
  sweepEnabled       Boolean @default(false)
  sweepMinBalanceSol Decimal @default(0.2) @db.Decimal(10, 4) // always left behind in the hot wallet

  lastSweepAt     DateTime?
  lastSweepStatus String? // "ok" | "skipped" | "error"
  lastSweepError  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per executed (or attempted) monthly sweep — the excess SOL above
// sweepMinBalanceSol, sent to SOLANA_SWEEP_DESTINATION. Kept even for
// failed attempts (status=FAILED, txSignature null) so the history is a
// complete audit trail, not just successes.
model SolanaSweep {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            String // "SUCCESS" | "FAILED"
  balanceBeforeSol  Decimal  @db.Decimal(20, 9) // on-chain wallet balance right before the transfer
  amountSol         Decimal  @db.Decimal(20, 9) // amount actually sent (0 for a failed/skipped attempt)
  destination       String // snapshot of SOLANA_SWEEP_DESTINATION at the time — env var could change later
  txSignature       String?
  errorMessage      String? @db.Text
  manual            Boolean @default(false) // true if triggered via "Trimite acum", false if the monthly cron

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum SolanaLotStatus {
  PENDING_SELL_ORDER // buy succeeded, sell trigger order creation failed/not yet attempted
  OPEN // sell trigger order live on Jupiter, waiting for price target
  FILLED // sell trigger order executed
  CANCELLED // sell trigger order cancelled (manually, via the UI)
  FAILED // the buy itself failed — no SOL acquired
}

// One row per DCA cycle ("lot") — links a buy to its take-profit sell so
// P&L and fees can be computed per lot, independent of internal Jupiter/
// on-chain ids (see lotId comment on jupiterOrderId below).
model SolanaLot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status SolanaLotStatus @default(PENDING_SELL_ORDER)

  // --- Buy side (always set once the lot exists) ---
  buyAmountUsd   Decimal  @db.Decimal(12, 4) // USD actually spent
  solAcquired    Decimal  @db.Decimal(20, 9) // SOL received from the swap
  buyPriceUsd    Decimal  @db.Decimal(14, 4) // effective price = buyAmountUsd / solAcquired
  buyFeeUsd      Decimal  @default(0) @db.Decimal(10, 4) // network + Jupiter fee, converted to USD
  buyTxSignature String?
  boughtAt       DateTime @default(now())

  // --- Sell trigger order (set once the order is created) ---
  targetPriceUsd     Decimal? @db.Decimal(14, 4)
  sellAmountSolPlanned Decimal? @db.Decimal(20, 9) // SOL put up for sale in the order
  jupiterOrderKey    String? // Jupiter's own order id — internal lot id above is what ties buy+sell together for P&L
  sellOrderCreatedAt DateTime?
  sellOrderTxSignature String?

  // --- Sell fill (set once Jupiter's keeper fills the order) ---
  soldAt          DateTime?
  solSold         Decimal?  @db.Decimal(20, 9)
  sellProceedsUsd Decimal?  @db.Decimal(14, 4)
  sellFeeUsd      Decimal?  @db.Decimal(10, 4)
  sellTxSignature String?

  // Last time reconcileOpenLots() checked this lot's order against
  // Jupiter — set on every daily cron run for every OPEN lot (cheap now
  // that it's a batched lookup, not one API call per lot), regardless of
  // whether the status actually changed. Shown in the UI so it's obvious
  // the bot is still watching, not just what the last known status was.
  lastCheckedAt DateTime?

  // SOL from this lot that is not part of the sell order (or not yet sold)
  // — stays in the wallet as a long-term holding.
  solRemaining Decimal @db.Decimal(20, 9)

  // (sellProceedsUsd - sellFeeUsd) - (buyAmountUsd-equivalent of solSold + buyFeeUsd share)
  // Null until the sell fills.
  realizedPnlUsd Decimal? @db.Decimal(12, 4)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, boughtAt])
}

// --- Base (ETH L2) DCA bot ---
// Same self-custody, single-dedicated-wallet model as the Solana bot above,
// adapted for an EVM chain: the private key never touches this database —
// it lives only as an env var on Vercel (BASE_PRIVATE_KEY), read at
// cron-execution time by src/lib/evm. Everything here is bookkeeping/config
// only.
//
// Two important differences from the Solana bot, both a consequence of Base
// being an EVM chain with ERC-20 tokens rather than native-SOL trading:
// 1. Gas is paid in native ETH, a SEPARATE asset from the WETH being
//    accumulated — unlike Solana where SOL is both the investment and the
//    fee currency. The wallet needs a small standing ETH balance for gas;
//    that's a manual top-up, not something this app tracks or sweeps.
// 2. ERC-20s require an on-chain `approve()` before a contract can move
//    them. src/lib/evm/oneinch.ts checks allowance and approves (once,
//    effectively forever via max uint256) lazily on first use — not
//    tracked here since it's derivable on-chain at any time.
//
// Flow: a Vercel Cron hits /api/cron/base-dca daily. The handler checks
// each enabled EvmSettings row — if `intervalHours` have passed since
// `lastRunAt`, it buys `buyAmountUsd` of WETH via 1inch's Classic Swap API
// (an immediate on-chain swap, exactly like the Solana buy leg), then
// signs (off-chain, gasless) a 1inch Limit Order Protocol v4 order to sell
// `sellAmountUsd` worth of the WETH just bought once the price rises by
// `takeProfitPercent`. A 1inch resolver fills that order later — this app
// does not poll price in between, same as the Solana Trigger order.
model EvmSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  // Public address only — never the private key. Shown in the UI so the
  // user can verify/fund the right wallet; also used to query 1inch/RPC.
  walletAddress String

  buyAmountUsd      Decimal @db.Decimal(10, 2) // e.g. 10.00 — spent each cycle
  intervalHours     Int     @default(24)
  takeProfitPercent Decimal @db.Decimal(6, 2) // e.g. 10.00 for "sell at +10%"
  sellAmountUsd     Decimal @db.Decimal(10, 2) // USD value of WETH sold per lot at target
  slippageBps       Int     @default(300) // 300 = 3% — Base USDC/WETH routes see enough price impact at ~$20 trade sizes that 50-150bps reverted in practice; see commit history

  lastRunAt     DateTime?
  lastRunStatus String? // "ok" | "skipped" | "error"
  lastRunError  String? @db.Text

  // --- Monthly auto-sweep to a cold wallet ---
  // Sweeps accumulated WETH (the investment) — never the native ETH gas
  // float, which this app doesn't touch. Off by default — must be
  // explicitly turned on after verifying with the manual "Trimite acum"
  // test. The destination address is deliberately NOT stored here: it
  // lives only as the BASE_SWEEP_DESTINATION Vercel env var, so
  // redirecting where funds go requires Vercel dashboard access, not just
  // a compromised web session (same reasoning as keeping the private key
  // out of the database).
  sweepEnabled        Boolean @default(false)
  sweepMinBalanceWeth Decimal @default(0) @db.Decimal(20, 9) // always left behind in the hot wallet, ON TOP OF whatever's reserved for open sell orders (see sweep.ts — unlike Solana, a 1inch order doesn't escrow funds on-chain)

  lastSweepAt     DateTime?
  lastSweepStatus String? // "ok" | "skipped" | "error"
  lastSweepError  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per executed (or attempted) monthly sweep — the excess WETH above
// sweepMinBalanceWeth, sent to BASE_SWEEP_DESTINATION. Kept even for failed
// attempts (status=FAILED, txHash null) so the history is a complete audit
// trail, not just successes.
model EvmSweep {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            String // "SUCCESS" | "FAILED"
  balanceBeforeWeth Decimal  @db.Decimal(30, 18) // on-chain WETH balance right before the transfer
  amountWeth        Decimal  @db.Decimal(30, 18) // amount actually sent (0 for a failed/skipped attempt)
  destination       String // snapshot of BASE_SWEEP_DESTINATION at the time — env var could change later
  txHash            String?
  errorMessage      String? @db.Text
  manual            Boolean @default(false) // true if triggered via "Trimite acum", false if the monthly cron

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum EvmLotStatus {
  PENDING_SELL_ORDER // buy succeeded, sell order creation failed/not yet attempted
  OPEN // sell limit order live on 1inch, waiting for price target
  FILLED // sell limit order executed
  CANCELLED // sell limit order cancelled (manually, via the UI) or expired
  FAILED // the buy itself failed — no WETH acquired
}

// One row per DCA cycle ("lot") — links a buy to its take-profit sell so
// P&L and fees can be computed per lot, independent of internal 1inch/
// on-chain ids. Mirrors SolanaLot field-for-field where the concepts
// carry over directly.
model EvmLot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status EvmLotStatus @default(PENDING_SELL_ORDER)

  // --- Buy side (always set once the lot exists) ---
  buyAmountUsd  Decimal  @db.Decimal(12, 4) // USD actually spent
  wethAcquired  Decimal  @db.Decimal(30, 18) // WETH received from the swap
  buyPriceUsd   Decimal  @db.Decimal(14, 4) // effective price = buyAmountUsd / wethAcquired
  buyFeeUsd     Decimal  @default(0) @db.Decimal(10, 4) // network gas (paid in ETH), converted to USD
  buyTxHash     String?
  boughtAt      DateTime @default(now())

  // --- Sell limit order (set once the order is created) ---
  // Placing a 1inch limit order is a gasless, off-chain signature — there
  // is no creation transaction the way Solana's Trigger order had one, so
  // sellOrderTxHash stays null; it's kept only in case a future variant of
  // this flow places orders on-chain.
  targetPriceUsd        Decimal? @db.Decimal(14, 4)
  sellAmountWethPlanned  Decimal? @db.Decimal(30, 18) // WETH put up for sale in the order
  oneInchOrderHash      String? // 1inch's own order hash — internal lot id above is what ties buy+sell together for P&L
  sellOrderCreatedAt    DateTime?
  sellOrderTxHash       String?

  // --- Sell fill (set once a 1inch resolver fills the order) ---
  // sellTxHash stays null even on a fill: the Orderbook API confirms a fill
  // happened (remainingMakerAmount drops to 0) but doesn't expose which
  // on-chain transaction did it, so there's no link to show — unlike the
  // buy side, which is always our own transaction and always has a hash.
  soldAt          DateTime?
  wethSold        Decimal?  @db.Decimal(30, 18)
  sellProceedsUsd Decimal?  @db.Decimal(14, 4)
  sellFeeUsd      Decimal?  @db.Decimal(10, 4)
  sellTxHash      String?

  // Last time reconcileOpenLots() checked this lot's order against 1inch's
  // orderbook — set on every daily cron run for every OPEN lot (cheap, a
  // batched lookup rather than one API call per lot). Shown in the UI so
  // it's obvious the bot is still watching.
  lastCheckedAt DateTime?

  // WETH from this lot that is not part of the sell order (or not yet
  // sold) — stays in the wallet as a long-term holding.
  wethRemaining Decimal @db.Decimal(30, 18)

  // (sellProceedsUsd - sellFeeUsd) - (buyAmountUsd-equivalent of wethSold + buyFeeUsd share)
  // Null until the sell fills.
  realizedPnlUsd Decimal? @db.Decimal(12, 4)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, boughtAt])
}

// Read-only accounts for people who aren't the admin (e.g. spouse, friends).
// Not part of NextAuth's User/Account/Session models on purpose — these
// people never get a real "account", just an allow-listed email + which
// dashboard sections they're allowed to see. Checked at login (alongside
// ADMIN_EMAILS) and used to compute session.user.allowedSections.
model ViewerAccess {
  id        String   @id @default(cuid())
  email     String   @unique
  label     String?  // optional friendly name, e.g. "Soția" — display only
  sections  String[] // keys from SECTION_KEYS in src/lib/permissions.ts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Flow: a Vercel Cron hits /api/cron/bnb-dca daily. The handler checks
// each enabled BnbSettings row — if `intervalHours` have passed since
// `lastRunAt`, it buys `buyAmountUsd` of WBNB via 1inch's Classic Swap API
// (an immediate on-chain swap, exactly like the Solana buy leg), then
// signs (off-chain, gasless) a 1inch Limit Order Protocol v4 order to sell
// `sellAmountUsd` worth of the WBNB just bought once the price rises by
// `takeProfitPercent`. A 1inch resolver fills that order later — this app
// does not poll price in between, same as the Solana Trigger order.
model BnbSettings {
