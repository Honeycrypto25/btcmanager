// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  
  // 2FA Fields
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  pendingTotpSecret   String?   // Secret temporar la setup 2FA — șters după activare

  // OTP Login Fields
  loginOtp            String?
  loginOtpExpires     DateTime?
  otpAttempts         Int?      // Rate limiting: număr cereri în fereastra curentă
  otpWindowStart      DateTime? // Rate limiting: începutul ferestrei de 10 minute
  
  accounts      Account[]
  sessions      Session[]
  t212Accounts  T212Account[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BitcoinWallet {
  id           String    @id @default(cuid())
  name         String
  address      String    @unique
  transactions BitcoinTransaction[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BitcoinTransaction {
  id           String    @id @default(cuid())
  txid         String    
  amount       Float     // BTC amount
  priceAtTime  Float     // Historical price at time of tx
  timestamp    DateTime
  
  walletId     String
  wallet       BitcoinWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime  @default(now())

  @@unique([txid, walletId])
}

// --- Trading 212 integration ---

model T212Account {
  id                  String    @id @default(cuid())
  userId              String
  label               String    @default("Trading 212")
  environment         String    @default("live") // "live" | "demo"
  apiKeyEncrypted     String    @db.Text
  apiSecretEncrypted  String    @db.Text
  currency            String?   // primary account currency, from account/info
  lastSyncedAt        DateTime?
  lastSyncError       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots T212Snapshot[]
  cashFlows T212CashFlow[]

  @@unique([userId, environment])
}

model T212Snapshot {
  id            String   @id @default(cuid())
  accountId     String
  capturedAt    DateTime @default(now())
  totalValue    Float // total account value (cash + invested)
  investedValue Float // cost basis of currently open positions
  freeCash      Float
  resultPpl     Float // unrealized P&L
  currency      String
  positions     Json // snapshot of open positions at capture time
  pies          Json // snapshot of pies (reflects current, post-rebalance allocations)

  account T212Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
}

model T212CashFlow {
  id         String   @id @default(cuid())
  accountId  String
  externalId String // Trading 212 transaction id, for de-duplication
  type       String // DEPOSIT | WITHDRAWAL | ...
  amount     Float
  dateTime   DateTime

  account T212Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId, dateTime])
}
